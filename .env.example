# Origem da API usada pelo rewrite do Next em /api/*
API_URL=http://localhost:3333

# Deixe vazio para chamar /api no mesmo domínio.
# Preencha só se o navegador for falar direto com a API.
NEXT_PUBLIC_API_URL=

# Client ID Web do Google (mesmo valor de GOOGLE_CLIENT_ID no back).
# Origens JavaScript autorizadas: http://localhost:3000
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
